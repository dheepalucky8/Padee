{
  "expo": {
    "name": "Padee",
    "slug": "padee",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "padee",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.padee.study",
      "infoPlist": {
        "NSCameraUsageDescription": "Padee needs the camera to photograph textbook pages for worksheets.",
        "NSPhotoLibraryUsageDescription": "Padee needs photo access to upload textbook page images."
      }
    },
    "android": {
      "package": "com.padee.study",
      "adaptiveIcon": {
        "backgroundColor": "#0F6B5C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Padee to photograph textbook pages.",
          "photosPermission": "Allow Padee to use textbook photos from your library."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F3FAF7"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
